# Herramientas locales de agentes y editores. Un `git add -A` se las lleva
# al PR de otro si no están acá.
.serena/
.claude/settings.local.json
.aider*
.cursor/
.idea/
.vscode/
.history/
__pycache__/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# Espejo local de una épica de Jira (jtk). Trae el registro de escrituras a Jira
# (jira-writes.jsonl), que no se commitea. `.jira-kanban/` es el nombre anterior.
.jira-team-kit/
.jira-kanban/

# macOS
.DS_Store

# Informes de auditoría generados localmente: son borradores hasta que se
# aprueban y se publican como issues.
AUDIT-REPORT.md
