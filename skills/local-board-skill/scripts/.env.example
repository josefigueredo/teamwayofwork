# Copy this template to <board-dir>/sync/.env and set the values required by the target tracker.
# Do not commit <board-dir>/sync/.env.

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_CLOUD_ID=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional: path to the complete CA bundle required by the local network.
# SSL_CERT_FILE=/path/to/additional-ca-bundle.pem
